<Window
    x:Class="ContextMenuManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ContextMenuManager.Core"
    xmlns:local="using:ContextMenuManager.App"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <!--  Narrow windows put the details pane under the menu instead of beside it.  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="880" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsPane.(Grid.Row)" Value="1" />
                        <Setter Target="DetailsPane.(Grid.Column)" Value="0" />
                        <Setter Target="DetailsPane.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Stands in for the system title bar (ExtendsContentIntoTitleBar).  -->
        <TextBlock
            x:Name="TitleBarText"
            x:Uid="AppTitle"
            Margin="16,10"
            Style="{StaticResource CaptionTextBlockStyle}" />

        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="Scroller_SizeChanged">
            <!--  Width is set from the viewport in code; MaxWidth alone let the panel overflow below 1148 px.  -->
            <StackPanel
                x:Name="ContentPanel"
                Margin="24,8,24,24"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    x:Uid="AppTitle"
                    Margin="0,0,0,16"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <tkcontrols:SettingsCard
                    x:Uid="Windows11MenuCard"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                    Visibility="{x:Bind ViewModel.IsWindows11}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsWindows11ContextMenu, Mode=TwoWay}" />
                </tkcontrols:SettingsCard>

                <TextBlock
                    x:Uid="PreviewGroupHeader"
                    Margin="1,28,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <InfoBar
                    x:Uid="HklmElevationNotice"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNotElevated}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartAsAdminButton" Click="RestartAsAdmin_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    x:Uid="RestartExplorerNotice"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.NeedsExplorerRestart, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartExplorerButton" Click="{x:Bind ViewModel.RestartExplorer}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <tkcontrols:SettingsCard x:Uid="PreviewTargetCard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsCapturing, Mode=OneWay}" />
                        <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.PreviewTargetIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="PreviewTarget_Desktop" />
                            <ComboBoxItem x:Uid="PreviewTarget_FolderBackground" />
                            <ComboBoxItem x:Uid="PreviewTarget_Folder" />
                            <ComboBoxItem x:Uid="PreviewTarget_File" />
                            <ComboBoxItem x:Uid="PreviewTarget_Drive" />
                        </ComboBox>
                        <Button x:Uid="RefreshButton" Click="{x:Bind ViewModel.LoadEntries}" />
                    </StackPanel>
                </tkcontrols:SettingsCard>

                <InfoBar
                    x:Uid="CaptureErrorNotice"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasCaptureError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.CaptureError, Mode=OneWay}"
                    Severity="Warning" />

                <Grid
                    Margin="0,8,0,0"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Styled after the classic Explorer context menu.  -->
                    <Border
                        Width="340"
                        Padding="4"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <HyperlinkButton
                                x:Uid="PreviewBackButton"
                                Margin="4,0,4,4"
                                Click="{x:Bind ViewModel.BackToModernMenu}"
                                Visibility="{x:Bind ViewModel.CanGoBackToModernMenu, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ContextMenuPreviewItem">
                                        <Grid>
                                            <Rectangle
                                                Height="1"
                                                Margin="0,4"
                                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Visibility="{x:Bind IsSeparator}" />
                                            <TextBlock
                                                Margin="12,4,12,2"
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Text}"
                                                Visibility="{x:Bind IsHeader}" />
                                            <Button
                                                Padding="12,5"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PreviewItem_Click"
                                                DataContext="{x:Bind}"
                                                Visibility="{x:Bind IsItem}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Opacity="{x:Bind TextOpacity}"
                                                        Source="{x:Bind local:Display.Image(Icon)}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Opacity="{x:Bind TextOpacity}"
                                                        Text="{x:Bind Text}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        Text="{x:Bind local:Display.SideText(IsOff, Shortcut)}" />
                                                    <FontIcon
                                                        Grid.Column="3"
                                                        FontSize="10"
                                                        Glyph="&#xE76C;"
                                                        Visibility="{x:Bind HasChildren}" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Details of the clicked menu item.  -->
                    <Border
                        x:Name="DetailsPane"
                        Grid.Column="1"
                        Padding="16"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid>
                            <TextBlock
                                x:Uid="DetailsPlaceholder"
                                Opacity="0.6"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image
                                        Width="20"
                                        Height="20"
                                        Source="{x:Bind local:Display.Image(ViewModel.SelectedPreviewItem.Icon), Mode=OneWay}" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedPreviewItem.Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Opacity="0.8"
                                    Text="{x:Bind ViewModel.SelectedDescription, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSelectedEntry, Mode=OneWay}">
                                    <TextBlock x:Uid="DetailsLocationHeader" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.SelectedLocation, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Uid="DetailsExtensionNote"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsSelectedExtension, Mode=OneWay}" />
                                <ToggleSwitch
                                    x:Uid="DetailsToggle"
                                    IsEnabled="{x:Bind ViewModel.SelectedEntry.IsToggleable, Mode=OneWay, FallbackValue=False}"
                                    IsOn="{x:Bind ViewModel.SelectedEntry.IsEnabled, Mode=OneWay, FallbackValue=False}"
                                    Toggled="DetailsToggleSwitch_Toggled"
                                    Visibility="{x:Bind ViewModel.HasSelectedEntry, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
